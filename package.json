{
  "name": "qdd-agent-harness-project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run build && node --env-file-if-exists=.env --enable-source-maps apps/cli/dist/index.js serve",
    "dev:web": "npm run dev --workspace @qdd/web",
    "build:web": "npm run build --workspace @qdd/web",
    "qdd": "node --env-file-if-exists=.env --enable-source-maps apps/cli/dist/index.js",
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "tsc -b && node --test \"apps/cli/dist/**/*.test.js\"",
    "clean": "tsc -b --clean",
    "start": "node --env-file-if-exists=.env --enable-source-maps apps/cli/dist/index.js serve"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
