{
  "name": "qdd-agent-harness-project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run build && node --env-file-if-exists=.env --enable-source-maps apps/cli/dist/index.js serve",
    "dev:web": "npm run dev --workspace @qdd/web",
    "build:web": "npm run build --workspace @qdd/web",
    "build:esp": "npm run build --workspace @qdd/esp",
    "build:android:screen": "npm run build --workspace @qdd/android-screen",
    "check:esp": "npm run check --workspace @qdd/esp",
    "idf:esp": "npm run idf --workspace @qdd/esp --",
    "validate:esp": "npm run validate --workspace @qdd/esp --",
    "android:mcp": "node --enable-source-maps apps/android-mcp/dist/index.js",
    "android:mcp:http": "node --enable-source-maps apps/android-mcp/dist/index.js --transport http",
    "test:android": "npm run test --workspace @qdd/android-mcp",
    "qdd": "node --env-file-if-exists=.env --enable-source-maps apps/cli/dist/index.js",
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "tsc -b && node --test \"apps/cli/dist/**/*.test.js\"",
    "clean": "tsc -b --clean",
    "start": "node --env-file-if-exists=.env --enable-source-maps apps/cli/dist/index.js serve"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
