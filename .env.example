# DeepSeek（或任意 OpenAI 兼容服务）
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# 网关 token（至少 16 位）；留空则自动生成到 workspace/.gateway-token
QDD_GATEWAY_TOKEN=

# 远程 MCP 的 Bearer token，变量名与 harness.config.json 中 bearerTokenEnv 对应
# ERP_MCP_TOKEN=

HOST=127.0.0.1
PORT=3000
# Optional: override the frontend's development/preview API proxy target.
# API_PROXY_TARGET=http://127.0.0.1:3000
# 连接器凭据加密密钥（可选；未设置时自动生成 workspace/.secret-key）
# QDD_SECRET_KEY=
