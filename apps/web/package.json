{
  "name": "@qdd/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "npm run typecheck && vite build",
    "typecheck": "node scripts/vue-typecheck.mjs --noEmit -p tsconfig.check.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "npm run typecheck",
    "clean": "node scripts/vue-typecheck.mjs --build --clean && node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\""
  },
  "dependencies": {
    "@qdd/shared": "0.0.0",
    "@icon-park/vue-next": "^1.4.2",
    "@tdesign-vue-next/chat": "^0.6.0",
    "@tiptap/core": "^3.27.3",
    "@tiptap/extension-history": "^3.27.3",
    "@tiptap/extension-mention": "^3.27.3",
    "@tiptap/extension-placeholder": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "@tiptap/vue-3": "^3.27.3",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.17.0",
    "dayjs": "^1.11.21",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "sass": "^1.100.0",
    "tdesign-vue-next": "^1.20.1",
    "tributejs": "^5.1.3",
    "vidstack": "^1.15.6",
    "vue": "^3.5.12",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@plugin-web-update-notification/vite": "^2.1.2",
    "@tdesign-vue-next/auto-import-resolver": "^0.1.6",
    "@types/file-saver": "^2.0.7",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "24.19.2",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.1.0",
    "vue-tsc": "^3.1.0"
  }
}
