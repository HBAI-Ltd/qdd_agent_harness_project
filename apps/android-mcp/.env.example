# Absolute path to platform-tools/adb.exe, or leave empty to discover adb.
ANDROID_ADB_PATH=
# Optional USB serial, used only by first-time App installation/diagnostics.
ANDROID_DEVICE_SERIAL=
# LAN URL shown in the installed Device Screen app.
ANDROID_SCREEN_URL=
# Optional exact phone App UUID; the explicit LAN URL selects the phone.
ANDROID_DEVICE_ID=
# Optional: absolute scrcpy.exe path for tools/preview.ps1 read-only USB mirroring.
ANDROID_SCRCPY_PATH=
# Control board LAN IPv4 or local DNS name. Wi-Fi takes priority when configured.
ESP_HOST=
# Must match the firmware TCP port. Keep 3333 unless changed on the board.
ESP_TCP_PORT=3333
# Optional LAN onboarding address, filled by automatic board discovery.
ESP_SETUP_URL=
# Optional USB fallback when ESP_HOST is empty. No automatic fallback after Wi-Fi errors.
ESP_PORT=
# stdio (default) or http. HTTP listens on 0.0.0.0 for local/private LAN access, without a token.
ANDROID_MCP_TRANSPORT=stdio
ANDROID_MCP_PORT=8790
