{
  "name": "haik-local-console",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "skill:build": "node scripts/build-mcp-skill.mjs",
    "skill:check": "node scripts/build-mcp-skill.mjs --check",
    "pretest": "npm run skill:check",
    "test": "node --import tsx --test tests/*.test.mjs",
    "build": "vite build --config local/vite.config.mjs",
    "start": "node local/server.mjs",
    "mcp": "node local/mcp-stdio.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "^1.31.0",
    "hls.js": "^1.7.3",
    "ezuikit-flv": "^2.1.1"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "@tailwindcss/postcss": "4.2.1",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.15",
    "jsdom": "^30.1.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.19.19"
  }
}
